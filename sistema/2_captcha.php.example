<?php
/**
 * MÓDULO 2 — CAPTCHA no Formulário de Cadastro
 * Opa Studio Security — PHP Puro
 * Usa hCaptcha (gratuito e sem rastreamento do Google)
 * 
 * Passo 1: Crie conta em https://www.hcaptcha.com/
 * Passo 2: Substitua as chaves abaixo
 * Passo 3: Adicione o widget no HTML do formulário
 * Passo 4: Valide no backend antes de salvar o cadastro
 */

// ─── Configuração ────────────────────────────────────────────────────────────
define('HCAPTCHA_SITE_KEY',   'PREENCHER');   // chave pública (vai no HTML)
define('HCAPTCHA_SECRET_KEY', 'PREENCHER'); // chave privada (fica no servidor)
define('HCAPTCHA_VERIFY_URL', 'https://hcaptcha.com/siteverify');

/**
 * Valida o token enviado pelo formulário
 * Retorna ['ok' => bool, 'message' => string]
 */
function verifyCaptcha(string $token, string $remoteIp = ''): array {
    if (empty($token)) {
        return ['ok' => false, 'message' => 'Por favor, complete o CAPTCHA.'];
    }

    $data = http_build_query([
        'secret'   => HCAPTCHA_SECRET_KEY,
        'response' => $token,
        'remoteip' => $remoteIp ?: ($_SERVER['REMOTE_ADDR'] ?? ''),
    ]);

    $options = [
        'http' => [
            'header'  => "Content-Type: application/x-www-form-urlencoded\r\n",
            'method'  => 'POST',
            'content' => $data,
            'timeout' => 5,
        ],
    ];

    $context  = stream_context_create($options);
    $result   = @file_get_contents(HCAPTCHA_VERIFY_URL, false, $context);

    if ($result === false) {
        // Se não conseguir verificar, deixa passar (não bloqueia usuário por falha de rede)
        error_log('[CAPTCHA] Falha ao contactar hCaptcha — permitindo passagem.');
        return ['ok' => true, 'message' => 'Verificação indisponível.'];
    }

    $json = json_decode($result, true);

    if (!empty($json['success'])) {
        return ['ok' => true, 'message' => 'CAPTCHA válido.'];
    }

    $errorCodes = $json['error-codes'] ?? [];
    error_log('[CAPTCHA] Falhou: ' . implode(', ', $errorCodes));

    return ['ok' => false, 'message' => 'Verificação de segurança falhou. Tente novamente.'];
}

